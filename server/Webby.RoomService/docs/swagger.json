{
    "swagger": "2.0",
    "info": {
        "description": "This API provides endpoints for managing rooms and categories.",
        "title": "Webby.RoomService",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/categories": {
            "get": {
                "description": "Retrieve a **paginated** list of room categories. Supports optional **search** by name.\n**Query Parameters Validation:**\n* `page`: must be \u003e= 1 (default: 1)\n* `limit`: must be between 1 and 100 (default: 10)\n* `search`: optional string to filter categories by name (case-insensitive)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "RoomCategory"
                ],
                "summary": "List categories",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Search categories by name (optional)",
                        "name": "search",
                        "in": "query"
                    },
                    {
                        "minimum": 1,
                        "type": "integer",
                        "default": 1,
                        "description": "Page number (1-based, required \u003e= 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "default": 10,
                        "description": "Items per page (1-100)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful retrieval with pagination metadata",
                        "schema": {
                            "$ref": "#/definitions/docs.ApiResponse-docs_PaginatedResponse-docs_CategoryResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid query parameters: page \u003c= 0, limit out of range, or non-numeric values",
                        "schema": {
                            "$ref": "#/definitions/docs.Error400Response"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/docs.Error500Response"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Create a new room category for organizing rooms.\n**Validation Rules:**\n* Name is **required** (cannot be null, empty, or whitespace-only)\n* Name length must be **2-50 characters**\n* Category name must be **unique** (409 Conflict if already exists)\n**Security Note:**\n* **ONLY ADMINISTRATORS** are authorized to perform this action.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "RoomCategory"
                ],
                "summary": "Create a new category",
                "parameters": [
                    {
                        "description": "**Category data.** Name (2-50 chars, required, unique)",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/docs.CreateCategoryRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Category successfully created",
                        "schema": {
                            "$ref": "#/definitions/docs.ApiResponse-docs_CategoryResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid input data: name missing, empty, too short (\u003c2), too long (\u003e50), or whitespace-only. Also: malformed JSON, wrong Content-Type",
                        "schema": {
                            "$ref": "#/definitions/docs.Error400Response"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid authentication token",
                        "schema": {
                            "$ref": "#/definitions/docs.Error401Response"
                        }
                    },
                    "403": {
                        "description": "Not authorized - Admin role required",
                        "schema": {
                            "$ref": "#/definitions/docs.Error403Response"
                        }
                    },
                    "409": {
                        "description": "Conflict: Category name already exists",
                        "schema": {
                            "$ref": "#/definitions/docs.Error409Response"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/docs.Error500Response"
                        }
                    }
                }
            }
        },
        "/categories/{id}": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Update an existing room category by ID. Only the **name** field is updateable.\n**Validation Rules:**\n* Name is **required** (cannot be null, empty, or whitespace-only)\n* Name length must be **2-50 characters**\n**Path Parameter Validation:**\n* `id`: must be a valid UUID v4 format\n**Security Note:**\n* **ONLY ADMINISTRATORS** are authorized to perform this action.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "RoomCategory"
                ],
                "summary": "Update a category",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Category ID (UUID v4 format)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Category update data - Name (2-50 chars, required, non-whitespace)",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/docs.UpdateCategoryRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Category successfully updated",
                        "schema": {
                            "$ref": "#/definitions/docs.ApiResponse-docs_CategoryResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid input: name missing, empty, too short (\u003c2), too long (\u003e50), whitespace-only, invalid UUID in path, or malformed JSON",
                        "schema": {
                            "$ref": "#/definitions/docs.Error400Response"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid authentication token",
                        "schema": {
                            "$ref": "#/definitions/docs.Error401Response"
                        }
                    },
                    "403": {
                        "description": "Not authorized - Admin role required",
                        "schema": {
                            "$ref": "#/definitions/docs.Error403Response"
                        }
                    },
                    "404": {
                        "description": "Category not found",
                        "schema": {
                            "$ref": "#/definitions/docs.Error404Response"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/docs.Error500Response"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Delete a room category by ID. **Permanent action - cannot be undone.**\n**Path Parameter Validation:**\n* `id`: must be a valid UUID v4 format\n**Security Note:**\n* **ONLY ADMINISTRATORS** are authorized to perform this action.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "RoomCategory"
                ],
                "summary": "Delete a category",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Category ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Category successfully deleted - No Content returned"
                    },
                    "400": {
                        "description": "Invalid UUID format in path",
                        "schema": {
                            "$ref": "#/definitions/docs.Error400Response"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid authentication token",
                        "schema": {
                            "$ref": "#/definitions/docs.Error401Response"
                        }
                    },
                    "403": {
                        "description": "Not authorized - Admin role required",
                        "schema": {
                            "$ref": "#/definitions/docs.Error403Response"
                        }
                    },
                    "404": {
                        "description": "Category not found",
                        "schema": {
                            "$ref": "#/definitions/docs.Error404Response"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/docs.Error500Response"
                        }
                    }
                }
            }
        },
        "/rooms": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Create a new room with a name, **category ID**, privacy setting, and optional **thumbnail**.\n**Validation Rules:**\n* `name`: **required**, 2-50 characters, cannot be null/empty/whitespace-only\n* `categoryId`: **required**, must be a valid UUID v4 format\n* `isPrivate`: **required**, must be valid boolean (\"true\" or \"false\")\n* `thumbnail`: optional file upload, max 2MB\n**Security Note:**\n* This action **requires authentication**",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rooms"
                ],
                "summary": "Create a new room",
                "parameters": [
                    {
                        "maxLength": 50,
                        "minLength": 2,
                        "type": "string",
                        "description": "Room name (2-50 chars, required, non-whitespace)",
                        "name": "name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Category ID (UUID v4, required)",
                        "name": "categoryId",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Visibility flag (required): 'true' or 'false'",
                        "name": "isPrivate",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Room thumbnail image (optional, max 2MB)",
                        "name": "thumbnail",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Room successfully created",
                        "schema": {
                            "$ref": "#/definitions/docs.ApiResponse-docs_RoomResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid input: name empty/too short/too long, invalid categoryId UUID, invalid isPrivate boolean, file too large, wrong Content-Type, or missing required fields",
                        "schema": {
                            "$ref": "#/definitions/docs.Error400Response"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid authentication token",
                        "schema": {
                            "$ref": "#/definitions/docs.Error401Response"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/docs.Error500Response"
                        }
                    }
                }
            }
        },
        "/rooms/my": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieve a paginated list of all rooms created by the authenticated user.\n**Query Parameter Validation:**\n* `page`: **optional** (default: 1), must be \u003e= 1, must be numeric\n* `limit`: **optional** (default: 10), must be 1-100, must be numeric\n**Security Note:**\n* This action **requires authentication**\n* Returns **only** the authenticated user's rooms\n* List includes both public and private rooms owned by the user",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rooms"
                ],
                "summary": "List authenticated user's rooms",
                "parameters": [
                    {
                        "minimum": 1,
                        "type": "integer",
                        "description": "Page number (default: 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "description": "Items per page (default: 10, max: 100)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User's rooms successfully retrieved",
                        "schema": {
                            "$ref": "#/definitions/docs.ApiResponse-PaginatedResponse[RoomListItem]"
                        }
                    },
                    "400": {
                        "description": "Invalid query parameters: page or limit not numeric, or outside valid range",
                        "schema": {
                            "$ref": "#/definitions/docs.Error400Response"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid authentication token",
                        "schema": {
                            "$ref": "#/definitions/docs.Error401Response"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/docs.Error500Response"
                        }
                    }
                }
            }
        },
        "/rooms/public": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieve a paginated list of all publicly visible rooms in the system.\n**Query Parameter Validation:**\n* `page`: **optional** (default: 1), must be \u003e= 1, must be numeric\n* `limit`: **optional** (default: 10), must be 1-100, must be numeric\n**Security Note:**\n* This action **requires authentication**\n* Returns **only** public rooms (private rooms are excluded)\n* Pagination prevents excessive data retrieval",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rooms"
                ],
                "summary": "List all public rooms",
                "parameters": [
                    {
                        "minimum": 1,
                        "type": "integer",
                        "description": "Page number (default: 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "description": "Items per page (default: 10, max: 100)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Public rooms successfully retrieved",
                        "schema": {
                            "$ref": "#/definitions/docs.ApiResponse-PaginatedResponse[RoomListItem]"
                        }
                    },
                    "400": {
                        "description": "Invalid query parameters: page or limit not numeric, or outside valid range",
                        "schema": {
                            "$ref": "#/definitions/docs.Error400Response"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid authentication token",
                        "schema": {
                            "$ref": "#/definitions/docs.Error401Response"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/docs.Error500Response"
                        }
                    }
                }
            }
        },
        "/rooms/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieve a room by its ID.\n**Access Rules:**\n* **Public rooms** can be retrieved by any authenticated user\n* **Private rooms** can only be retrieved by the room creator or administrators\n**Path Parameter Validation:**\n* `id`: must be a valid UUID v4 format\n**Security Note:**\n* This action **requires authentication**",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rooms"
                ],
                "summary": "Get a room by ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Room ID (UUID v4 format)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Room successfully retrieved",
                        "schema": {
                            "$ref": "#/definitions/docs.ApiResponse-docs_RoomResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid UUID format in path",
                        "schema": {
                            "$ref": "#/definitions/docs.Error400Response"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid authentication token",
                        "schema": {
                            "$ref": "#/definitions/docs.Error401Response"
                        }
                    },
                    "403": {
                        "description": "Access denied - private room and not owner",
                        "schema": {
                            "$ref": "#/definitions/docs.Error403Response"
                        }
                    },
                    "404": {
                        "description": "Room not found",
                        "schema": {
                            "$ref": "#/definitions/docs.Error404Response"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/docs.Error500Response"
                        }
                    }
                }
            },
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Update a room's name, **category ID**, privacy setting, and **thumbnail** by ID.\n**Validation Rules:**\n* `name`: **required**, 2-50 characters, cannot be null/empty/whitespace-only\n* `categoryId`: **required**, must be a valid UUID v4 format\n* `isPrivate`: **required**, must be valid boolean (\"true\" or \"false\")\n* `thumbnail`: optional file upload, max 2MB\n**Path Parameter Validation:**\n* `id`: must be a valid UUID v4 format\n**Security Note:**\n* This action **requires authentication**\n* **Only the authorized room creator** can update this room",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rooms"
                ],
                "summary": "Update a room",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Room ID (UUID v4 format)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "maxLength": 50,
                        "minLength": 2,
                        "type": "string",
                        "description": "Room name (2-50 chars, required)",
                        "name": "name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Category ID (UUID v4, required)",
                        "name": "categoryId",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Visibility flag ('true' or 'false', required)",
                        "name": "isPrivate",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "New thumbnail image (optional, max 2MB)",
                        "name": "thumbnail",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Room successfully updated",
                        "schema": {
                            "$ref": "#/definitions/docs.ApiResponse-docs_RoomResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid input: name validation failed, invalid UUID, invalid boolean, file too large, or missing required fields",
                        "schema": {
                            "$ref": "#/definitions/docs.Error400Response"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid authentication token",
                        "schema": {
                            "$ref": "#/definitions/docs.Error401Response"
                        }
                    },
                    "403": {
                        "description": "Not authorized - only creator or admin can update",
                        "schema": {
                            "$ref": "#/definitions/docs.Error403Response"
                        }
                    },
                    "404": {
                        "description": "Room not found",
                        "schema": {
                            "$ref": "#/definitions/docs.Error404Response"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/docs.Error500Response"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Delete a room by ID. **Permanent action - cannot be undone.**\n**Path Parameter Validation:**\n* `id`: must be a valid UUID v4 format\n**Security Note:**\n* This action **requires authentication**\n* **Only the authorized room creator** can delete this room",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rooms"
                ],
                "summary": "Delete a room",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Room ID (UUID v4 format)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Room successfully deleted - No Content returned"
                    },
                    "400": {
                        "description": "Invalid UUID format in path",
                        "schema": {
                            "$ref": "#/definitions/docs.Error400Response"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid authentication token",
                        "schema": {
                            "$ref": "#/definitions/docs.Error401Response"
                        }
                    },
                    "403": {
                        "description": "Not authorized - only creator or admin can delete",
                        "schema": {
                            "$ref": "#/definitions/docs.Error403Response"
                        }
                    },
                    "404": {
                        "description": "Room not found",
                        "schema": {
                            "$ref": "#/definitions/docs.Error404Response"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/docs.Error500Response"
                        }
                    }
                }
            }
        }
