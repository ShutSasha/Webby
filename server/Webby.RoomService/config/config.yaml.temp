env: "local"
connectionString: "{{UriConnectionString}}"
jwtSecret: "{{JwtAccessSecretKey}}"

worker:
  points_per_tick: 67
  interval: 1m
  zombie_ttl: 2m

http:
  host: "localhost"
  port: 8080
  timeout: 10s

aws:
  accessKey: "{{AwsAccessKey}}"
  secretKey: "{{AwsSecretKey}}"
  region: "{{AwsRegion}}"
  bucket: "{{AwsBucketName}}"
  
grpc:
  host: "localhost"
  port: 50054
  mediaServiceAddress: "localhost:5005"
  chatServiceAddress: "localhost:50051"
  categoryServiceAddress: "localhost:50052"
  queueServiceAddress: "localhost:50053"
  notificationServiceAddress: "localhost:5007"

redis:
  addr: "localhost:6379"
  password: "{{RedisPassword}}"
  db: 0
