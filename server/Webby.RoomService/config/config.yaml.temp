env: "local"
connectionString: "{{UriConnectionString}}"
jwtSecret: "{{JwtAccessSecretKey}}"

worker:
  points_per_tick: 67
  interval: 1m
  zombie_ttl: 2m

http:
  serviceAddress: "{{HttpRoomAddress}}" 
  timeout: 10s

aws:
  accessKey: "{{AwsAccessKey}}"
  secretKey: "{{AwsSecretKey}}"
  region: "{{AwsRegion}}"
  bucket: "{{AwsBucketName}}"
  
grpc:
  roomServiceAddress: "{{RoomGrpcServiceUrl}}"
  roomQueueServiceAddress: "{{RoomQueueGrpcServiceUrl}}"
  mediaServiceAddress: "{{GoVideoGrpcServiceUrl}}"
  chatServiceAddress: "{{ChatGrpcServiceUrl}}"
  roomCategoryServiceAddress: "{{RoomCategoryGrpcServiceUrl}}"
  notificationServiceAddress: "{{GoNotificationGrpcServiceUrl}}"

redis:
  addr: "{{RedisAddress}}"
  password: "{{RedisPassword}}"
  db: 0
