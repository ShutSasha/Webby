env: "{{Env}}"
jwtSecret: "MyExtraMegaSuperKeyThatYouCanUnderstand"
connectionString: "{{UriConnectionString}}"

token_ttl: 5m

http:
  serviceAddress: "{{HttpWsGatewayAddress}}" 
  timeout: 10s
  call_timeout: 5s

redis:
  addr: "{{RedisAddress}}"
  password: "{{RedisPassword}}"
  db: 0
  pattern: "*:*"

grpc:
  chatServiceAddress: "{{ChatGrpcServiceUrl}}"
