{
  "openapi": "3.0.3",
  "info": {
    "title": "Webby.WsGateway",
    "version": "1.0"
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Authorization token (pass in the Header)"
      }
    },
    "schemas": {
      "Token": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": {
            "type": "string",
            "example": "Token generated successfully"
          },
          "data": {
            "type": "string",
            "example": "sdfnsdfj134",
            "description": "One-time token for WebSocket connection"
          },
          "errors": {
            "type": "object",
            "nullable": true,
            "example": null
          }
        }
      },
      "InternalServerError": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string", "example": "Error generating token" },
          "data": {
            "type": "object",
            "nullable": true,
            "example": null
          },
          "errors": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "example": "error generating token"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/ws-token": {
      "get": {
        "summary": "Retrieve token to connect to WS",
        "tags": ["WebSocket"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Token generated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Token" }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InternalServerError" }
              }
            }
          }
        }
      }
    }
  }
}
