env: "local"
connectionString: "{{UriConnectionString}}"
jwtSecret: "{{JwtAccessSecretKey}}"
http:
  host: "localhost"
  port: 8082
  timeout: 10s
grpc:
  host: "localhost"
  port: 50052
  mediaServiceAddress: "localhost:5005"
  complaintServiceAddress: "localhost:5004"
  notificationServiceAddress: "localhost:5007"
