env: "local"
connectionString: "{{UriConnectionString}}"
jwtSecret: "{{JwtAccessSecretKey}}"

http:
  serviceAddress: "{{HttpAdminAddress}}"
  timeout: 10s
  
grpc:
  mediaServiceAddress: "{{VideoGrpcServiceUrl}}"
  roomServiceAddress: "{{RoomGrpcServiceUrl}}"
  complaintServiceAddress: "{{UserGrpcServiceUrl}}"
  notificationServiceAddress: "{{NotificationGrpcServiceUrl}}"
