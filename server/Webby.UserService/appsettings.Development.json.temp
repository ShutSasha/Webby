{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AppDbContext": "{{DatabaseConnectionString}}",
    "Redis": "{{RedisDbConnectionString}}"
  },
  
  "AwsOptions": {
    "AccessKey": "{{AwsAccessKey}}",
    "SecretKey": "{{AwsSecretKey}}",
    "BucketName": "{{AwsBucketName}}",
    "Region": "{{AwsRegion}}"
  },
  
  "PaymentOptions":{
    "PaymentPublicKey": "{{StripePublishableKey}}",
    "PaymentSecretKey": "{{StripeSecretKey}}",
    "PaymentWebhookKey": "{{StripeWebhookKey}}",
    "SuccessUrl": "{{PaymentSuccessUrl}}",
    "CancelUrl": "{{PaymentCancelUrl}}"
  },
  
 "AutoMapper":{
    "LicenseKey": "{{AutoMapperLicenseKey}}"
  },
  
  "GrpcClients": {
    "VideoServiceUrl": "{{VideoGrpcServiceUrl}}",
    "NotificationServiceUrl": "{{NotificationGrpcServiceUrl}}",
    "AchievementServiceUrl": "{{AchievementGrpcServiceUrl}}"
  }
  
}
