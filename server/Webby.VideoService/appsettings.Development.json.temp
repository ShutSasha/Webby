{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AppDbContext": "{{DatabaseConnectionString}}"
  },
  
    "AwsOptions": {
    "AccessKey": "{{AwsAccessKey}}",
    "SecretKey": "{{AwsSecretKey}}",
    "BucketName": "{{AwsBucketName}}",
    "Region": "{{AwsRegion}}"
    },
  
    "ExternalServices": {
      "YouTubeOptions": {
        "ApiKey": "{{YouTubeApiKey}}"
      },
      "TwitchOptions": {
        "ClientId": "{{TwitchIdClient}}",
        "ClientSecret": "{{TwitchSecretKey}}",
        "ThumbnailWidth": "1280",
        "ThumbnailHeight": "720"
      }
    },
    
   "AutoMapper":{
      "LicenseKey": "{{AutoMapperLicenseKey}}"
   },
   
   "GrpcClients": {
     "UserServiceUrl": "http://localhost:5004"
   }
  
}
