{
  "Routes": [
    {
      "DownstreamPathTemplate": "/swagger/doc.yaml",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "room-server",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/room/swagger/v1/swagger.json",
      "UpstreamHttpMethod": ["GET"],
      "AuthenticationOptions": {
        "AllowAnonymous": true
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "room-server",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/rooms",
      "UpstreamHttpMethod": ["POST"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms/my",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "room-server",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/my",
      "UpstreamHttpMethod": ["GET"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms/public",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "room-server",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/public",
      "UpstreamHttpMethod": ["GET"]
    },
    {
      "DownstreamPathTemplate": "/api/rooms/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "room-server",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/{id}",
      "UpstreamHttpMethod": ["GET", "PUT", "DELETE"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms/{id}/members",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "room-server",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/{id}/members",
      "UpstreamHttpMethod": ["POST"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms/{id}/members/{memberId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "room-server",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/{id}/members/{memberId}",
      "UpstreamHttpMethod": ["DELETE"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms/{id}/members/points",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "room-server",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/{id}/members/points",
      "UpstreamHttpMethod": ["GET"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms/{id}/members/{memberId}/points",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "room-server",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/{id}/members/{memberId}/points",
      "UpstreamHttpMethod": ["PATCH"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms/{id}/sync",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "room-server",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/{id}/sync",
      "UpstreamHttpMethod": ["POST"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms/{id}/sync/report",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "room-server",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/{id}/sync/report",
      "UpstreamHttpMethod": ["POST"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    }
  ]
}
