{
  "Routes": [
    {
      "DownstreamPathTemplate": "/swagger/doc.json",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "chat-service",
          "Port": 8081
        }
      ],
      "UpstreamPathTemplate": "/chat/swagger/v1/swagger.json",
      "UpstreamHttpMethod": ["GET"],
      "AuthenticationOptions": {
        "AllowAnonymous": true
      }
    },
    {
      "DownstreamPathTemplate": "/api/chats",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "chat-service",
          "Port": 8081
        }
      ],
      "UpstreamPathTemplate": "/api/chats",
      "UpstreamHttpMethod": ["POST"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/chats/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "chat-service",
          "Port": 8081
        }
      ],
      "UpstreamPathTemplate": "/api/chats/{id}",
      "UpstreamHttpMethod": ["GET"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/socket.io/{everything}",
      "DownstreamScheme": "ws",
      "DownstreamHostAndPorts": [
        {
          "Host": "chat-service",
          "Port": 8081
        }
      ],
      "UpstreamPathTemplate": "/socket.io/{everything}",
      "UpstreamHttpMethod": ["GET", "POST"]
    }
  ]
}
