{
   "Routes":[
      {
         "DownstreamPathTemplate": "/docs/achievement-service/v1/swagger.json",
         "DownstreamScheme": "http",
         "DownstreamHostAndPorts": [
            {
               "Host": "achievement-service",
               "Port": 5008
            }
         ],
         "UpstreamPathTemplate": "/achievement/swagger/v1/swagger.json",
         "UpstreamHttpMethod": [ "GET" ],
         "AuthenticationOptions": {
            "AllowAnonymous": true
         }
      },

      {
         "DownstreamPathTemplate": "/api/achievements",
         "DownstreamScheme": "http",
         "DownstreamHostAndPorts": [
            {
               "Host": "achievement-service",
               "Port": 5008
            }
         ],
         "UpstreamPathTemplate": "/api/achievements",
         "UpstreamHttpMethod": [
            "GET"
         ]
      },

      {
         "DownstreamPathTemplate": "/api/achievements",
         "DownstreamScheme": "http",
         "DownstreamHostAndPorts": [
            {
               "Host": "achievement-service",
               "Port": 5008
            }
         ],
         "UpstreamPathTemplate": "/api/achievements",
         "UpstreamHttpMethod": [
            "POST","PUT"
         ],
         "AuthenticationOptions": {
            "AuthenticationProviderKey": "Bearer"
         },
         "RouteClaimsRequirement": {
            "Role": "Moderator"
         }
      },

      {
         "DownstreamPathTemplate": "/api/achievements/{achievementId}",
         "DownstreamScheme": "http",
         "DownstreamHostAndPorts": [
            {
               "Host": "achievement-service",
               "Port": 5008
            }
         ],
         "UpstreamPathTemplate": "/api/achievements/{achievementId}",
         "UpstreamHttpMethod": [
            "DELETE"
         ],
         "AuthenticationOptions": {
            "AuthenticationProviderKey": "Bearer"
         },
         "RouteClaimsRequirement": {
            "Role": "Moderator"
         }
      },

      {
         "DownstreamPathTemplate": "/api/achievements/{userId}",
         "DownstreamScheme": "http",
         "DownstreamHostAndPorts": [
            {
               "Host": "achievement-service",
               "Port": 5008
            }
         ],
         "UpstreamPathTemplate": "/api/achievements/{userId}",
         "UpstreamHttpMethod": [
            "GET"
         ]
      },
      
      {
         "DownstreamPathTemplate": "/api/achievements/{achievementId}/users/{userId}/unlock",
         "DownstreamScheme": "http",
         "DownstreamHostAndPorts": [
            {
               "Host": "achievement-service",
               "Port": 5008
            }
         ],
         "UpstreamPathTemplate": "/api/achievements/{achievementId}/users/{userId}/unlock",
         "UpstreamHttpMethod": [
            "POST"
         ],
         "AuthenticationOptions": {
            "AuthenticationProviderKey": "Bearer"
         },
         "RouteClaimsRequirement": {
            "Role": "Moderator"
         }
      }
   ]
}