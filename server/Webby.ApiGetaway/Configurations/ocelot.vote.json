{
  "Routes": [
    {
      "DownstreamPathTemplate": "/swagger/doc.yaml",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "127.0.0.1",
          "Port": 8084
        }
      ],
      "UpstreamPathTemplate": "/vote/swagger/v1/swagger.json",
      "UpstreamHttpMethod": ["GET"],
      "AuthenticationOptions": {
        "AllowAnonymous": true
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms/{id}/votes",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "127.0.0.1",
          "Port": 8084
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/{id}/votes",
      "UpstreamHttpMethod": ["POST", "GET"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms/{id}/votes/{voteId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "127.0.0.1",
          "Port": 8084
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/{id}/votes/{voteId}",
      "UpstreamHttpMethod": ["GET", "DELETE"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms/{id}/votes/{voteId}/cast",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "127.0.0.1",
          "Port": 8084
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/{id}/votes/{voteId}/cast",
      "UpstreamHttpMethod": ["POST", "DELETE"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    }
  ]
}
