{
  "Routes": [
    {
      "DownstreamPathTemplate": "/swagger/doc.yaml",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "127.0.0.1",
          "Port": 8084
        }
      ],
      "UpstreamPathTemplate": "/vote/swagger/v1/swagger.json",
      "UpstreamHttpMethod": ["GET"],
      "AuthenticationOptions": {
        "AllowAnonymous": true
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms/{id}/votes/right-choice",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "127.0.0.1",
          "Port": 8084
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/{id}/votes/right-choice",
      "UpstreamHttpMethod": ["POST"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms/{id}/votes",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "127.0.0.1",
          "Port": 8084
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/{id}/votes",
      "UpstreamHttpMethod": ["GET"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms/{id}/votes/{voteId}/vote",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "127.0.0.1",
          "Port": 8084
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/{id}/votes/{voteId}/vote",
      "UpstreamHttpMethod": ["GET"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/rooms/{id}/votes/{voteId}/resolve",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "127.0.0.1",
          "Port": 8084
        }
      ],
      "UpstreamPathTemplate": "/api/rooms/{id}/votes/{voteId}/resolve",
      "UpstreamHttpMethod": ["POST"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    }
  ]
}
