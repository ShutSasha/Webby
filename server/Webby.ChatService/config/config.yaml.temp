env: "{{Env}}"
connectionString: "{{UriConnectionString}}"
jwtSecret: "{{JwtAccessSecretKey}}"

http:
  serviceAddress: "{{HttpChatAddress}}"
  timeout: 10s

redis:
  addr: "{{RedisAddress}}"
  password: "{{RedisPassword}}"
  db: 0

grpc:
  chatServiceAddress: "{{ChatGrpcServiceUrl}}"
  roomServiceAddress: "{{RoomGrpcServiceUrl}}"
  userServiceAddress: "{{GoUserGrpcServiceUrl}}"
